    <section id="about" class="about-us-area section-padding">
        <div class="container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="section-title text-center">
                        <h2><%= (aboutSection && aboutSection.section_title) ? aboutSection.section_title : 'about us' %></h2>
                        <span></span>
                        <p><%= (aboutSection && aboutSection.section_subtitle) ? aboutSection.section_subtitle : 'Lorem ipsum dolor sit amet consectetur adipisicing elit.' %></p>
                    </div>
                </div>
            </div>
            <div class="featured-area text-center">
                <div class="row">
                    <% const features = aboutFeatures && aboutFeatures.length ? aboutFeatures : [{ icon_class: 'fa fa-mobile', title: 'Fully Responsive', description: 'Lorem ipsum dolor sit amet consectetur adipisicing elitsed ation Lorem ipsum' }, { icon_class: 'fa fa-code', title: 'clean code', description: 'Lorem ipsum dolor sit amet consectetur adipisicing elitsed ation Lorem ipsum' }, { icon_class: 'fa fa-check-square', title: 'Easy To Customize', description: 'Lorem ipsum dolor sit amet consectetur adipisicing elitsed ation Lorem ipsum' }]; %>
                    <% features.forEach(f => { %>
                    <div class="col-md-4 col-sm-4">
                        <div class="single-featured">
                            <i class="fa <%= f.icon_class || 'fa-star' %>"></i>
                            <h4><%= f.title || '' %></h4>
                            <p><%= f.description || '' %></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 col-sm-6">
                    <div class="about-text">
                        <h4><%- (aboutSection && aboutSection.welcome_heading) ? aboutSection.welcome_heading : 'welcome to <span>nastro</span>' %></h4>
                        <p><%= (aboutSection && aboutSection.welcome_text) ? aboutSection.welcome_text : 'Lorem Ipsum is simply dummy text of the printing and typesetting industry.' %></p>
                        <a class="about-btn" href="<%= (aboutSection && aboutSection.read_more_url) ? aboutSection.read_more_url : '#' %>">read more</a>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6">
                    <div class="our-Expertise">
                        <h4>Our Expertise</h4>
                        <% const expItems = expertise && expertise.length ? expertise : [{ label: 'graphic design', percent: 90 }, { label: 'Web design', percent: 85 }, { label: 'development', percent: 90 }, { label: 'wordpress', percent: 95 }, { label: 'jQuery', percent: 80 }]; %>
                        <% expItems.forEach(e => { const p = parseInt(e.percent, 10) || 0; %>
                        <div class="progress-bar-inner">
                            <p class="progress-bar-text"><%= e.label || '' %> <span><%= p %>%</span></p>
                            <div class="progress-bar"><span style="width: <%= p %>%;" data-percent="<%= p %>"></span></div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>
