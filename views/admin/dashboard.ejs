<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin — Corporate Template</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <span class="navbar-brand">Admin Panel</span>
            <div>
                <a href="/" class="btn btn-outline-light btn-sm me-2">View site</a>
                <button type="button" class="btn btn-outline-light btn-sm" id="logoutBtn">Logout</button>
            </div>
        </div>
    </nav>
    <div class="container py-4">
        <div class="alert alert-info">Edit a section and click Save. Changes appear on the main page immediately.</div>
        <div class="accordion" id="adminAccordion">
            <!-- Site settings -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#site">Site (meta, logo, copyright)</button>
                </h2>
                <div id="site" class="accordion-collapse collapse show" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <form id="formSite">
                            <div class="row g-2">
                                <div class="col-md-6"><label class="form-label">Meta title</label><input type="text" name="metaTitle" class="form-control" value="<%= (content.site && content.site.meta_title) || '' %>"></div>
                                <div class="col-md-6"><label class="form-label">Logo text</label><input type="text" name="logoText" class="form-control" value="<%= (content.site && content.site.logo_text) || '' %>"></div>
                                <div class="col-12"><label class="form-label">Meta description</label><textarea name="metaDescription" class="form-control" rows="2"><%= (content.site && content.site.meta_description) || '' %></textarea></div>
                                <div class="col-12"><label class="form-label">Footer copyright</label><input type="text" name="footerCopyright" class="form-control" value="<%= (content.site && content.site.footer_copyright) || '' %>"></div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-2">Save site</button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Hero -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#hero">Hero slides</button>
                </h2>
                <div id="hero" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <div id="heroSlidesContainer"></div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="heroAdd">+ Add slide</button>
                        <form id="formHero" class="mt-2"><button type="submit" class="btn btn-primary">Save hero</button></form>
                    </div>
                </div>
            </div>
            <!-- About -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#about">About section</button>
                </h2>
                <div id="about" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <form id="formAbout">
                            <div class="mb-2"><label class="form-label">Section title</label><input type="text" name="sectionTitle" class="form-control" value="<%= (content.aboutSection && content.aboutSection.section_title) || '' %>"></div>
                            <div class="mb-2"><label class="form-label">Section subtitle</label><textarea name="sectionSubtitle" class="form-control" rows="2"><%= (content.aboutSection && content.aboutSection.section_subtitle) || '' %></textarea></div>
                            <div class="mb-2"><label class="form-label">Welcome heading (HTML ok)</label><input type="text" name="welcomeHeading" class="form-control" value="<%= (content.aboutSection && content.aboutSection.welcome_heading) ? content.aboutSection.welcome_heading.replace(/"/g, '&quot;') : '' %>"></div>
                            <div class="mb-2"><label class="form-label">Welcome text</label><textarea name="welcomeText" class="form-control" rows="3"><%= (content.aboutSection && content.aboutSection.welcome_text) || '' %></textarea></div>
                            <div class="mb-2"><label class="form-label">Read more URL</label><input type="text" name="readMoreUrl" class="form-control" value="<%= (content.aboutSection && content.aboutSection.read_more_url) || '' %>"></div>
                            <button type="submit" class="btn btn-primary">Save about</button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Get started CTA -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#getStarted">Get started CTA</button>
                </h2>
                <div id="getStarted" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <form id="formGetStarted">
                            <div class="row g-2">
                                <div class="col-12"><input type="text" name="heading" class="form-control" placeholder="Heading" value="<%= (content.getStarted && content.getStarted.heading) || '' %>"></div>
                                <div class="col-12"><input type="text" name="subheading" class="form-control" placeholder="Subheading" value="<%= (content.getStarted && content.getStarted.subheading) || '' %>"></div>
                                <div class="col-6"><input type="text" name="buttonText" class="form-control" placeholder="Button text" value="<%= (content.getStarted && content.getStarted.button_text) || '' %>"></div>
                                <div class="col-6"><input type="text" name="buttonUrl" class="form-control" placeholder="Button URL" value="<%= (content.getStarted && content.getStarted.button_url) || '' %>"></div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-2">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- Services -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#services">Services</button>
                </h2>
                <div id="services" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <div id="servicesContainer"></div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="servicesAdd">+ Add service</button>
                        <form id="formServices" class="mt-2"><button type="submit" class="btn btn-primary">Save services</button></form>
                    </div>
                </div>
            </div>
            <!-- Team -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#team">Team members</button>
                </h2>
                <div id="team" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <div id="teamContainer"></div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="teamAdd">+ Add member</button>
                        <form id="formTeam" class="mt-2"><button type="submit" class="btn btn-primary">Save team</button></form>
                    </div>
                </div>
            </div>
            <!-- Contact & Footer -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contact">Contact & footer</button>
                </h2>
                <div id="contact" class="accordion-collapse collapse" data-bs-parent="#adminAccordion">
                    <div class="accordion-body">
                        <form id="formContact">
                            <h6>Contact</h6>
                            <div class="row g-2 mb-2">
                                <div class="col-12"><input type="text" name="address" class="form-control" placeholder="Address" value="<%= (content.contactInfo && content.contactInfo.address) || '' %>"></div>
                                <div class="col-6"><input type="text" name="phone" class="form-control" placeholder="Phone" value="<%= (content.contactInfo && content.contactInfo.phone) || '' %>"></div>
                                <div class="col-6"><input type="text" name="email" class="form-control" placeholder="Email" value="<%= (content.contactInfo && content.contactInfo.email) || '' %>"></div>
                                <div class="col-12"><input type="text" name="website" class="form-control" placeholder="Website" value="<%= (content.contactInfo && content.contactInfo.website) || '' %>"></div>
                                <div class="col-12"><label class="form-label">Map embed src (iframe src)</label><textarea name="map_embed_src" class="form-control" rows="2"><%= (content.contactInfo && content.contactInfo.map_embed_src) || '' %></textarea></div>
                            </div>
                            <h6 class="mt-3">Footer</h6>
                            <div class="mb-2"><input type="text" name="about_heading" class="form-control" placeholder="Footer about heading" value="<%= (content.footer && content.footer.about_heading) ? content.footer.about_heading.replace(/"/g, '&quot;') : '' %>"></div>
                            <div class="mb-2"><textarea name="about_text" class="form-control" rows="2" placeholder="Footer about text"><%= (content.footer && content.footer.about_text) || '' %></textarea></div>
                            <div class="mb-2"><input type="text" name="copyright_text" class="form-control" placeholder="Copyright text" value="<%= (content.footer && content.footer.copyright_text) || '' %>"></div>
                            <button type="submit" class="btn btn-primary">Save contact & footer</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const content = <%- JSON.stringify(content) %>;

        document.getElementById('logoutBtn').onclick = async () => {
            await fetch('/api/admin/logout', { method: 'POST' });
            window.location.href = '/admin/login';
        };

        async function apiPut(url, body) {
            const res = await fetch(url, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Failed');
            return data;
        }

        function showMsg(el, ok, text) {
            const div = document.createElement('div');
            div.className = ok ? 'alert alert-success mt-2' : 'alert alert-danger mt-2';
            div.textContent = text;
            el.after(div);
            setTimeout(() => div.remove(), 3000);
        }

        // Site
        document.getElementById('formSite').onsubmit = async (e) => {
            e.preventDefault();
            const fd = new FormData(e.target);
            try {
                await apiPut('/api/admin/site', { metaTitle: fd.get('metaTitle'), metaDescription: fd.get('metaDescription'), logoText: fd.get('logoText'), footerCopyright: fd.get('footerCopyright') });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        // Hero
        function renderHeroSlides() {
            const slides = content.heroSlides && content.heroSlides.length ? content.heroSlides : [{ title: '', subtitle: '' }];
            const container = document.getElementById('heroSlidesContainer');
            container.innerHTML = slides.map((s, i) => `
                <div class="card mb-2 slide-row" data-i="${i}">
                    <div class="card-body">
                        <input type="text" class="form-control mb-1 slide-title" placeholder="Title" value="${(s.title || '').replace(/"/g, '&quot;')}">
                        <textarea class="form-control slide-subtitle" rows="2" placeholder="Subtitle">${s.subtitle || ''}</textarea>
                    </div>
                </div>
            `).join('');
        }
        renderHeroSlides();
        document.getElementById('heroAdd').onclick = () => {
            const container = document.getElementById('heroSlidesContainer');
            const div = document.createElement('div');
            div.className = 'card mb-2 slide-row';
            div.innerHTML = '<div class="card-body"><input type="text" class="form-control mb-1 slide-title" placeholder="Title"><textarea class="form-control slide-subtitle" rows="2" placeholder="Subtitle"></textarea></div>';
            container.appendChild(div);
        };
        document.getElementById('formHero').onsubmit = async (e) => {
            e.preventDefault();
            const slides = Array.from(document.querySelectorAll('.slide-row')).map(row => ({
                title: row.querySelector('.slide-title').value,
                subtitle: row.querySelector('.slide-subtitle').value
            }));
            try {
                await apiPut('/api/admin/hero', { slides });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        // About
        document.getElementById('formAbout').onsubmit = async (e) => {
            e.preventDefault();
            const fd = new FormData(e.target);
            try {
                await apiPut('/api/admin/about', { sectionTitle: fd.get('sectionTitle'), sectionSubtitle: fd.get('sectionSubtitle'), welcomeHeading: fd.get('welcomeHeading'), welcomeText: fd.get('welcomeText'), readMoreUrl: fd.get('readMoreUrl') });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        // Services
        function renderServices() {
            const list = content.services && content.services.length ? content.services : [];
            const container = document.getElementById('servicesContainer');
            container.innerHTML = list.map((s, i) => `
                <div class="card mb-2 service-row" data-i="${i}">
                    <div class="card-body">
                        <input type="text" class="form-control mb-1 service-title" placeholder="Title" value="${(s.title || '').replace(/"/g, '&quot;')}">
                        <textarea class="form-control service-desc" rows="2" placeholder="Description">${s.description || ''}</textarea>
                    </div>
                </div>
            `).join('') || '<p class="text-muted">No services. Click + Add service.</p>';
        }
        renderServices();
        document.getElementById('servicesAdd').onclick = () => {
            const container = document.getElementById('servicesContainer');
            if (container.querySelector('.text-muted')) container.innerHTML = '';
            const div = document.createElement('div');
            div.className = 'card mb-2 service-row';
            div.innerHTML = '<div class="card-body"><input type="text" class="form-control mb-1 service-title" placeholder="Title"><textarea class="form-control service-desc" rows="2" placeholder="Description"></textarea></div>';
            container.appendChild(div);
        };
        document.getElementById('formServices').onsubmit = async (e) => {
            e.preventDefault();
            const services = Array.from(document.querySelectorAll('.service-row')).map(row => ({
                icon_class: 'fa-briefcase',
                title: row.querySelector('.service-title').value,
                description: row.querySelector('.service-desc').value
            }));
            try {
                await apiPut('/api/admin/services', { services });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        // Team
        function renderTeam() {
            const list = content.teamMembers && content.teamMembers.length ? content.teamMembers : [];
            const container = document.getElementById('teamContainer');
            container.innerHTML = list.map((m, i) => `
                <div class="card mb-2 team-row">
                    <div class="card-body">
                        <input type="text" class="form-control mb-1 team-name" placeholder="Name" value="${(m.name || '').replace(/"/g, '&quot;')}">
                        <input type="text" class="form-control mb-1 team-role" placeholder="Role" value="${(m.role || '').replace(/"/g, '&quot;')}">
                        <textarea class="form-control mb-1 team-bio" rows="2" placeholder="Bio">${m.bio || ''}</textarea>
                        <input type="text" class="form-control team-img" placeholder="Image URL" value="${(m.image_url || '').replace(/"/g, '&quot;')}">
                    </div>
                </div>
            `).join('') || '<p class="text-muted">No members. Click + Add member.</p>';
        }
        renderTeam();
        document.getElementById('teamAdd').onclick = () => {
            const container = document.getElementById('teamContainer');
            if (container.querySelector('.text-muted')) container.innerHTML = '';
            const div = document.createElement('div');
            div.className = 'card mb-2 team-row';
            div.innerHTML = '<div class="card-body"><input type="text" class="form-control mb-1 team-name" placeholder="Name"><input type="text" class="form-control mb-1 team-role" placeholder="Role"><textarea class="form-control mb-1 team-bio" rows="2" placeholder="Bio"></textarea><input type="text" class="form-control team-img" placeholder="Image URL"></div>';
            container.appendChild(div);
        };
        document.getElementById('formTeam').onsubmit = async (e) => {
            e.preventDefault();
            const members = Array.from(document.querySelectorAll('.team-row')).map(row => ({
                name: row.querySelector('.team-name').value,
                role: row.querySelector('.team-role').value,
                bio: row.querySelector('.team-bio').value,
                image_url: row.querySelector('.team-img').value
            }));
            try {
                await apiPut('/api/admin/team', { members });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        // Contact & footer
        document.getElementById('formContact').onsubmit = async (e) => {
            e.preventDefault();
            const fd = new FormData(e.target);
            try {
                await apiPut('/api/admin/contact', { address: fd.get('address'), phone: fd.get('phone'), email: fd.get('email'), website: fd.get('website'), map_embed_src: fd.get('map_embed_src') });
                await apiPut('/api/admin/footer', { about_heading: fd.get('about_heading'), about_text: fd.get('about_text'), copyright_text: fd.get('copyright_text') });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };

        document.getElementById('formGetStarted').onsubmit = async (e) => {
            e.preventDefault();
            const fd = new FormData(e.target);
            try {
                await apiPut('/api/admin/get-started', { heading: fd.get('heading'), subheading: fd.get('subheading'), buttonText: fd.get('buttonText'), buttonUrl: fd.get('buttonUrl') });
                showMsg(e.target.querySelector('button[type=submit]'), true, 'Saved.');
            } catch (err) { showMsg(e.target.querySelector('button[type=submit]'), false, err.message); }
        };
    </script>
</body>
</html>
