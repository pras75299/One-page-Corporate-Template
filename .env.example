# PostgreSQL connection string (required for admin + dynamic content)
DATABASE_URL=postgresql://user:password@localhost:5432/corporate_template

# Session secret for admin login (change in production)
SESSION_SECRET=your-secret-key-change-in-production

# Admin password (used by seed; change after first login)
ADMIN_PASSWORD=admin123

# Optional: port (default 3000)
# PORT=3000
